[user]
        name = Adam Patterson
        email = adam@adamrt.com
        signingkey = 6EA6FC1D
        useConfigOnly = true
# Work identity for openly-engineering repos (matches the remote URL as stored).
[includeIf "hasconfig:remote.*.url:*github.com?openly-engineering/**"]
        path = ~/.gitconfig-work
[includeIf "hasconfig:remote.*.url:*github.com?openly-engineering-sandbox/**"]
        path = ~/.gitconfig-work
[core]
        excludesFile = ~/.gitignore
[diff]
        algorithm = histogram
[url "ssh://git@github.com:/"]
        insteadOf = https://github.com/
[commit]
        gpgSign = true
[tag]
        gpgSign = true
[github]
        user = adamrt
[init]
	defaultBranch = master
