general {
    output_format = "i3bar"
    colors = true
    color_good = "#d0d0d0"
    color_degraded = "#e5b566"
    color_bad = "#ff5555"
    interval = 5
}

order += "wireless _first_"
order += "ethernet _first_"
order += "memory"
order += "disk /"
order += "battery all"
order += "tztime local"

wireless _first_ {
    format_up = "WiFi %essid"
    format_down = ""
}

ethernet _first_ {
    format_up = "Eth %ip"
    format_down = ""
}

memory {
    format = "RAM %used"
}

disk "/" {
    format = "Disk %avail"
}

battery all {
    format = "Bat %percentage"
    format_down = ""
    low_threshold = 20
    threshold_type = "percentage"
    color_bad = "#ff5555"
}

tztime local {
    format = "%a %b %d %H:%M"
}
