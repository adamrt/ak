general {
    output_format = "i3bar"
    colors = false
    interval = 5
}

order += "wireless _first_"
order += "ethernet _first_"
order += "memory"
order += "disk /"
order += "battery all"
order += "tztime local"

wireless _first_ {
    format_up = "WiFi %essid"
    format_down = ""
}

ethernet _first_ {
    format_up = "Eth %ip"
    format_down = ""
}

memory {
    format = "RAM %used"
}

disk "/" {
    format = "Disk %avail"
}

battery all {
    format = "Bat %percentage"
    format_down = ""
}

tztime local {
    format = "%a %b %d %H:%M"
}
